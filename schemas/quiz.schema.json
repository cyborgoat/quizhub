{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Quizzy quiz file",
  "description": "Editor aid only. scripts/validate.ts is authoritative (it also checks index ranges, uniqueness, KaTeX and cross-file links).",
  "type": "object",
  "required": ["id", "title", "questions"],
  "additionalProperties": true,
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "tags": { "type": "array", "items": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" } },
    "questions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "type", "prompt"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "prompt": { "type": "string", "minLength": 1 },
          "explanation": { "type": "string", "minLength": 1 }
        },
        "oneOf": [
          {
            "properties": {
              "type": { "const": "single_choice" },
              "options": { "type": "array", "minItems": 2, "items": { "type": "string", "minLength": 1 } },
              "answerIndex": { "type": "integer", "minimum": 0 }
            },
            "required": ["options", "answerIndex"]
          },
          {
            "properties": {
              "type": { "const": "multiple_choice" },
              "options": { "type": "array", "minItems": 2, "items": { "type": "string", "minLength": 1 } },
              "answerIndices": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "integer", "minimum": 0 } }
            },
            "required": ["options", "answerIndices"]
          },
          {
            "properties": { "type": { "const": "true_false" }, "answer": { "type": "boolean" } },
            "required": ["answer"]
          }
        ]
      }
    }
  }
}
